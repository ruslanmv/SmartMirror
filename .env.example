SMARTMIRROR_ENV=development
SMARTMIRROR_HOST=0.0.0.0
SMARTMIRROR_PORT=8100
SMARTMIRROR_DATABASE_URL=postgresql+psycopg://smartmirror:smartmirror@postgres:5432/smartmirror
SMARTMIRROR_REDIS_URL=redis://redis:6379/0

SMARTMIRROR_S3_ENDPOINT=http://minio:9000
SMARTMIRROR_S3_ACCESS_KEY=smartmirror
SMARTMIRROR_S3_SECRET_KEY=change-me
SMARTMIRROR_S3_BUCKET=smartmirror
SMARTMIRROR_S3_REGION=us-east-1

HOMEPILOT_BASE_URL=http://host.docker.internal:8000
HOMEPILOT_API_KEY=

OLLABRIDGE_BASE_URL=https://ruslanmv-ollabridge.hf.space
OLLABRIDGE_TOKEN=
OLLABRIDGE_NODE_ID=

SMARTMIRROR_PUBLIC_MCP_URL=http://smartmirror-api:8100/rpc
SMARTMIRROR_BODY_CAPTURE_TTL_HOURS=24
SMARTMIRROR_PREVIEW_TTL_HOURS=168
SMARTMIRROR_MAX_UPLOAD_MB=25

# Media storage: "s3" uses the MinIO bucket above (compose); "local" uses SMARTMIRROR_MEDIA_DIR.
SMARTMIRROR_STORAGE=s3
SMARTMIRROR_MEDIA_DIR=./media

# AI try-on: "homepilot" = HomePilot images.edit node job on this PC
# (HomePilot: HOMEPILOT_MIRROR_JOBS_ENABLED=true, HOMEPILOT_MIRROR_IMAGE_EDIT_ENABLED=true,
#  and NODE_MANIFEST_ALLOW_HOSTS=<this container's IP> when SmartMirror runs in Docker);
# "ollabridge-cloud" = no local GPU (the photo leaves the house for that call); "none".
SMARTMIRROR_IMAGE_PROVIDER=homepilot
SMARTMIRROR_INLINE_JOBS=true
SMARTMIRROR_TRYON_TIMEOUT_S=600

# "Complete the look" shopping: "off" (default), "linkout" = an Amazon search link the
# owner opens on their phone (the mirror never buys). Creators API is not implemented.
SMARTMIRROR_SHOPPING=off
AMAZON_DOMAIN=com
AMAZON_PARTNER_TAG=

# Per-profile tool rate limits (try-ons, photo uploads, …) and app log level.
SMARTMIRROR_RATE_LIMITS=true
SMARTMIRROR_LOG_LEVEL=INFO
