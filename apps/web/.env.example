# Server-only settings for the SmartMirror web BFF (set them in Vercel → Project → Environment Variables).
# Never prefix these with NEXT_PUBLIC_: that would ship them to every browser.

# demo | direct | ollabridge. Leave unset to auto-detect: ollabridge on Vercel, demo in local development.
SMARTMIRROR_BACKEND=

# 32+ random characters; encrypts the HttpOnly session cookie. Required for direct/ollabridge.
SMARTMIRROR_SESSION_SECRET=

# Profile the BFF acts on (the browser cannot choose another one).
SMARTMIRROR_PROFILE_ID=local-user

# --- direct mode (local development against the FastAPI service) ---
SMARTMIRROR_API_URL=http://localhost:8100
# Optional: require screens to enter this code before using a direct backend.
SMARTMIRROR_ACCESS_CODE=

# --- ollabridge mode ---
# Gateway root (no /v1). Leave empty with SMARTMIRROR_BACKEND=ollabridge to use https://app.ollabridge.com.
OLLABRIDGE_BASE_URL=
# Screens pair themselves with OllaBridge (like the 3D Avatar Chatbot):
#   device = show ABCD-1234 + QR, confirm on the phone (POST /device/start, /device/poll)
#   code   = type the code from the OllaBridge dashboard (POST OLLABRIDGE_PAIRING_PATH)
OLLABRIDGE_PAIRING_FLOW=device
OLLABRIDGE_PAIRING_PATH=/pair
# Stylist persona (HomePilot, published as API model). Empty = discover persona:stylist--…
OLLABRIDGE_STYLIST_MODEL=
# Optional single-owner token held only on the server (screens then pair with SMARTMIRROR_ACCESS_CODE).
OLLABRIDGE_TOKEN=
OLLABRIDGE_NODE_ID=
# HomePilot node job that runs SmartMirror's MCP tools (HomePilot HP-1). Legacy: mcp.tools_call
OLLABRIDGE_MCP_OPERATION=agentic.invoke
OLLABRIDGE_MCP_SERVER=smartmirror
